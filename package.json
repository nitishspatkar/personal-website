{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "description": "Personal site (Express + Markdown)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-path=server.js --watch-path=config.yml --watch-path=views --watch-path=content/data --watch-path=content/short_bio.md server.js",
