<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title, description, siteTitle, path, gaId }) %>
</head>
<body class="site-body">
  <%- include('partials/header') %>
  <main class="site-main site-main--page">
    <article class="section section--page teaching-page">
      <div class="section__inner">
        <h1 class="page-title"><%= research.title %></h1>
        <% if (research.intro) { %>
        <p class="lede teaching-page__lede"><%= research.intro %></p>
        <% } %>

        <% if (research.pi_projects && research.pi_projects.length) { %>
        <section class="teaching-block research-projects__section" aria-labelledby="pi-heading">
          <header class="teaching-block__head">
            <h2 id="pi-heading" class="teaching-block__inst">As Principal Investigator</h2>
          </header>
          <ul class="service-list">
            <% research.pi_projects.forEach(function (p) { %>
            <li class="service-list__item">
              <% if (p.period) { %>
              <span class="service-list__period"><%= p.period %></span>
              <% } %>
              <span class="service-list__title"><%= p.title %></span>
              <% if (p.meta) { %>
              <span class="service-list__meta"><%= p.meta %></span>
              <% } %>
            </li>
            <% }); %>
          </ul>
        </section>
        <% } %>

        <% if (research.collaborator_summary) {
             var cs = research.collaborator_summary;
        %>
        <section class="teaching-block research-projects__section" aria-labelledby="collab-heading">
          <header class="teaching-block__head">
            <h2 id="collab-heading" class="teaching-block__inst">As collaborator</h2>
          </header>
          <% if (cs.intro) { %>
          <p class="lede teaching-page__lede"><%= cs.intro %></p>
          <% } else if (cs.count) { %>
          <p class="lede teaching-page__lede">Collaborator on <%= cs.count %> further innovation projects spanning these domains:</p>
          <% } %>
          <% if (cs.domains && cs.domains.length) { %>
          <ul class="service-list service-list--compact">
            <% cs.domains.forEach(function (d) { %>
            <li class="service-list__item"><%= d %></li>
            <% }); %>
          </ul>
          <% } %>
        </section>
        <% } %>
      </div>
    </article>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
